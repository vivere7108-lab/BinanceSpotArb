{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRecordings",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET/phase0/*"
    },
    {
      "Sid": "ListRecordings",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::BUCKET"
    }
  ]
}
